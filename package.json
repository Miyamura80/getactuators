{
    "name": "actuatorlist",
    "version": "0.1.0",
    "description": "A community directory of actuators for robotics and motion systems",
    "type": "module",
    "scripts": {
        "dev": "bun run --watch scripts/serve_frontend.ts",
        "start": "bun run scripts/serve_frontend.ts",
        "build": "cd frontend && bun run build",
        "fmt": "biome check --write",
        "lint": "biome check",
        "deadcode": "knip",
        "typecheck": "tsc --noEmit",
        "lint:links": "find . -name '*.md' -not -path './node_modules/*' -not -path './docs/*' | xargs markdown-link-check --quiet --config .markdown-link-check.json",
        "ci": "bun run lint && bun run deadcode && bun run typecheck && bun run lint:links",
        "test": "bun test",
        "test:fast": "bun test --timeout 5000",
        "test:watch": "bun test --watch",
        "images:fetch": "bun run scripts/fetch_actuator_images.ts",
        "images:optimize": "bun run scripts/optimize_actuator_images.ts",
        "images:sync": "bun run scripts/fetch_actuator_images.ts && bun run scripts/optimize_actuator_images.ts"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.0",
        "@modelcontextprotocol/client": "^2.1.0",
        "@types/bun": "^1.3.9",
        "@types/d3-geo": "^3.1.1",
        "@types/topojson-client": "^3.1.5",
        "dependency-cruiser": "^17.3.8",
        "jscpd": "^4.0.8",
        "knip": "^5.0.0",
        "markdown-link-check": "^3.12.0",
        "typescript": "^5.7.0"
    },
    "dependencies": {
        "@clack/prompts": "^1.0.1",
        "@modelcontextprotocol/server": "^2.1.0",
        "d3-geo": "^3.1.1",
        "sharp": "^0.34.5",
        "topojson-client": "^3.1.0",
        "zod": "^4.3.6"
    }
}
