# Deploy environment: dev, staging or prod (read in src/server/site.ts)
DEV_ENV=dev

# Optional canonical public origin; defaults to https://actuatorlist.com.
# Override for preview or staging deployments.
SITE_URL=

# Optional catalog freshness timestamp (ISO 8601), normally set at deploy time.
# Falls back to the last git commit touching the dataset, then its file mtime.
CATALOG_UPDATED_AT=

# Optional public GA4 web-stream ID (server runtime only).
# Leave empty until the owner completes docs/measurement.md; no tracking by default.
GA4_MEASUREMENT_ID=

# Optional Logo.dev publishable key (pk_..., public; frontend build time).
# Company logos hotlink from img.logo.dev; leave empty to draw monograms.
# Vite reads it from frontend/.env, not this root file. See docs/brand-logos.md.
VITE_LOGO_DEV_TOKEN=
